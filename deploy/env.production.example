# Production .env for the droplet. Copy to /var/www/nailpolish/.env and fill in the blanks.
APP_NAME="Nail Polish Collector"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://example.com
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database: Postgres. Keep connections open between requests: the biggest single speed-up in load testing
# (500 users: page p95 1,391 ms -> 100 ms).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nailpolish
DB_USERNAME=nailpolish
DB_PASSWORD=
DB_PERSISTENT=true

# Database-backed sessions, cache and queue scaled best in testing. (File sessions slowed pages down: PHP's cleanup scans
# every session file.) Redis would be the next step up.
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Sign-in emails go out through this. MAIL_MAILER=log (the default) writes them to a log file and sends nothing.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS="signin@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# The account with this address becomes the first Admin when it signs in.
ADMIN_EMAIL=
SELF_SIGNUP_LIMIT=100

# Photos: 'photos' is a private folder on the droplet. Point at an S3-compatible disk (e.g. DigitalOcean Spaces) to keep
# them off the droplet (needs: composer require league/flysystem-aws-s3-v3).
PHOTOS_DISK=photos
MAX_PHOTOS_PER_USER=500

# NEVER set this in production. It lifts every rate limit and exists only for load testing (load/README.md).
LOAD_TEST_MODE=false
